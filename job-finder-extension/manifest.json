{
  "manifest_version": 3,
  "name": "Job Finder",
  "version": "1.32.2",
  "minimum_chrome_version": "116",
  "description": "Watches Coconala, Lancers, CrowdWorks and Workana for new jobs, with client verification, detailed job and client views, Windows notifications, Google Translate / DeepL, and bidding through Slack with Freelance Account Checker.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Job Finder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": [
    "https://www.lancers.jp/*",
    "https://coconala.com/*",
    "https://crowdworks.jp/*",
    "https://www.workana.com/*",
    "https://translate.googleapis.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://slack.com/*",
    "https://files.slack.com/*"
  ]
}
